# ===========================================
# Configuração do Servidor
# ===========================================

# Porta onde a aplicação será executada
# Padrão: 3000
PORT=3000

# Ambiente de execução da aplicação
# Valores possíveis: development, test, production
# development: modo desenvolvimento com hot-reload
# test: modo testes automatizados
# production: modo produção com otimizações
NODE_ENV=development

# ===========================================
# Configuração do Banco de Dados
# ===========================================

# URL de conexão com o banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO?schema=NOME_SCHEMA
#
# Exemplo local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs-clean-arch-dev?schema=public"
#
# Exemplo Docker:
# DATABASE_URL="postgresql://postgres:docker@localhost:5432/nestjs-clean-arch-dev?schema=public"
#
# Exemplo produção (Render, Heroku, etc):
# DATABASE_URL="postgres://usuario:senha@host:5432/nome_banco?schema=public"
DATABASE_URL="postgresql://postgres:docker@localhost:5432/projectdb?schema=public"

# ===========================================
# Configuração JWT (Autenticação)
# ===========================================

# Chave secreta para assinatura dos tokens JWT
# IMPORTANTE: Em produção, use uma chave forte e complexa!
# Dica: Use ferramentas como openssl ou sites especializados para gerar chaves seguras
# Exemplo: openssl rand -base64 32
JWT_SECRET=my_secret

# Tempo de expiração do token JWT em segundos
# Padrão: 86400 (24 horas)
# Exemplos:
# 3600 = 1 hora
# 86400 = 24 horas
# 604800 = 7 dias
# 2592000 = 30 dias
JWT_EXPIRES_IN=86400
